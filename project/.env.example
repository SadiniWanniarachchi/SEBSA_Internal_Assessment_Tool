# Server-only configuration. Copy to .env.local for local development.
MONGODB_URI=mongodb://localhost:27017/sebsa_assessment
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
BREVO_API_KEY=replace-with-your-server-only-brevo-key
EMAIL_FROM=no-reply@example.com
BREVO_SENDER_NAME=SEBSA Internal Assessment
HR_EMAIL_CC=hr@example.com
APP_URL=http://localhost:3000
EMPLOYEE_DEFAULT_PASSWORD=replace-with-a-local-password
SEED_ADMIN_PASSWORD=replace-with-a-local-password
SEED_EMPLOYEE_PASSWORD=replace-with-a-local-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=SEBSA Administrator
# JSON array supplied only in the local environment; keep real employee data out of Git.
SEED_EMPLOYEES_JSON=[]
